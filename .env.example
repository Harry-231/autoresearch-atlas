APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
DEPENDENCY_TIMEOUT_SECONDS=3

# Supabase local Postgres. Keep server code on DATABASE_URL, not browser keys.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
POSTGRES_SCHEMA=crucible
LANGGRAPH_CHECKPOINT_SCHEMA=lg_checkpoints

# Neo4j Community Edition local graph store.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=autoresearch

# Redis live trace streams. Durable replay is persisted to crucible.events.
REDIS_URL=redis://127.0.0.1:6379/0

# MinIO / S3 artifact store.
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=crucible-artifacts
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
