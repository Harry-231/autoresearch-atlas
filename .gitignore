# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules/
.pnpm-store/
.venv/
apps/*/.venv/
.pnp
.pnp.js

# Local env files (sensitive — never commit real env files; templates are whitelisted)
.env
.env.*
*.env
.env.local
.env*.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env.hosting.example
!.env*.example

# Local sprint execution reports
docs/Sprint_*.md

# Python
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
.mypy_cache/
.pyright/
.ruff_cache/
.coverage
htmlcov/

# Testing
coverage/
_tmp_*

# Turbo
.turbo/
apps/*/.turbo/
*.tsbuildinfo

# Supabase
supabase/.temp/
supabase/.branches/

# Vercel
.vercel/

# Build Outputs
.next/
apps/*/.next/
out/
build/
dist/

# Generated scratch outputs (presentations, exports, etc.)
outputs/

# Debug
*.log
*.stackdump
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Secrets / credentials
*.pem
*.key
*.crt
*.p12
*.pfx

# Misc / editor
.DS_Store
Thumbs.db
*.swp
*~
