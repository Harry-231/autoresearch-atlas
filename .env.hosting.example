APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
DEPENDENCY_TIMEOUT_SECONDS=5

# Supabase hosted Postgres direct connection string.
# Use the app server only; do not expose this to Next.js public env vars.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
POSTGRES_SCHEMA=crucible
LANGGRAPH_CHECKPOINT_SCHEMA=lg_checkpoints

# Managed or self-hosted Neo4j.
NEO4J_URI=neo4j+s://<host>:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<password>

# Managed Redis for live streams.
REDIS_URL=rediss://:<password>@<host>:6379/0

# S3-compatible artifact store.
S3_ENDPOINT_URL=https://s3.<region>.amazonaws.com
S3_ACCESS_KEY_ID=<access-key-id>
S3_SECRET_ACCESS_KEY=<secret-access-key>
S3_BUCKET=crucible-artifacts
S3_REGION=<region>
S3_FORCE_PATH_STYLE=false
